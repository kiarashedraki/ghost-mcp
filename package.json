{
  "name": "ghost-admin-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Ghost Admin API — manage posts, pages, tags, and images from any MCP client",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ghost",
    "ghost-cms",
    "ghost-admin-api",
    "blog"
  ],
  "license": "MIT",
  "author": "Kevin Edraki",
  "type": "module",
  "bin": {
    "ghost-admin-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
